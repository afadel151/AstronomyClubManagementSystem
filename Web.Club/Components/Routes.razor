@inject NavigationManager Navigation

<CascadingAuthenticationState>
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="authContext">
                @if (authContext.User.Identity?.IsAuthenticated == true)
                {
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 40vh">
                            <RadzenCard Style="width: min(100%, 30rem)">
                                <RadzenStack Gap="1rem" AlignItems="AlignItems.Center">
                                    <RadzenIcon Icon="lock" Style="font-size: 3rem" />
                                    <RadzenText Text="Access denied" TextStyle="TextStyle.H4" />
                                    <RadzenButton Icon="arrow_forward"
                                                  Text="Open access page"
                                                  Click="@(() => Navigation.NavigateTo("/account/access-denied"))" />
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenStack>
                    </LayoutView>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 40vh">
                        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width: 12rem" />
                    </RadzenStack>
                </LayoutView>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
</CascadingAuthenticationState>
