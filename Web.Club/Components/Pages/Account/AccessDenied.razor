@page "/account/access-denied"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Access denied</PageTitle>

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: calc(100vh - 6rem)">
    <RadzenCard Style="width: min(100%, 30rem)">
        <RadzenStack Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenIcon Icon="lock" Style="font-size: 3rem" />
            <RadzenText Text="Access denied" TextStyle="TextStyle.H4" />
            <RadzenText Text="Your account does not have permission to open this page." TextAlign="TextAlign.Center" />
            <RadzenButton Icon="home"
                          Text="Go home"
                          Click="@(() => Navigation.NavigateTo("/"))"
                          ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>
