@page "/account/register"
@inherits Web.Club.Components.Base.AnonymousOnlyComponentBase
@layout GuestLayout
@attribute [AllowAnonymous]


<PageTitle>Register</PageTitle>

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
             Style="min-height: calc(100vh - 6rem)">
    <RadzenCard Style="width: min(100%, 38rem)">
        <RadzenStack Gap="1rem">
            <RadzenStack Gap="0.25rem">
                <RadzenText Text="Create account" TextStyle="TextStyle.H4" />
                <RadzenText Text="Join the club member portal." TextStyle="TextStyle.Body2" />
                @if (Error == "true")
                {
                    <RadzenText Text="Registration failed. Check if email already exists or passwords match."
                                TextStyle="TextStyle.Body2" style="color: var(--rz-danger)" />
                }
            </RadzenStack>
            @* <RadzenTemplateForm Data="@model" Submit="@HandleSubmit"> *@
            <form method="post" action="/bff/register" style="width: 100%">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Full name" Variant="Variant.Outlined" Style="width: 100%">
                        <RadzenTextBox Name="FullName" Style="width: 100%" />
                    </RadzenFormField>

                    <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%">
                        <RadzenTextBox Name="Email" Style="width: 100%" />
                    </RadzenFormField>
                    @* @if (errors.ContainsKey(nameof(model.Email)))
                    {
                        <RadzenText Text="@errors[nameof(model.Email)][0]" style="color:red" />
                    } *@
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: 100%"
                                 class="account-form-grid">
                        <RadzenStack Gap="0.25rem" Style="flex: 1">
                            <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="width: 100%">
                                <RadzenPassword Name="Password" Style="width: 100%" />
                            </RadzenFormField>
                        </RadzenStack>

                        <RadzenStack Gap="0.25rem" Style="flex: 1">
                            <RadzenFormField Text="Confirm password" Variant="Variant.Outlined" Style="width: 100%">
                                <RadzenPassword Name="ConfirmPassword" Style="width: 100%" />
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: 100%"
                                 class="account-form-grid">
                        <RadzenFormField Text="Display name" Variant="Variant.Outlined" Style="flex: 1">
                            <RadzenTextBox Name="DisplayName" Style="width: 100%" />
                        </RadzenFormField>

                        <RadzenFormField Text="City" Variant="Variant.Outlined" Style="flex: 1">
                            <RadzenTextBox Name="City" Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="width: 100%"
                                 class="account-form-grid">
                        <RadzenFormField Text="Nationality" Variant="Variant.Outlined" Style="flex: 1">
                            <RadzenTextBox Name="Nationality" Style="width: 100%" />
                        </RadzenFormField>

                        <RadzenFormField Text="AAVSO observer code" Variant="Variant.Outlined" Style="flex: 1">
                            <RadzenTextBox Name="AavsoObserverCode" Style="width: 100%" />
                        </RadzenFormField>
                    </RadzenStack>

                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Icon="person_add"
                                  Text="Create account" Style="width: 100%" />

                    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Icon="login"
                                  Text="Back to sign in" Click="@(() => Nav.NavigateTo("/account/login"))"
                                  Style="width: 100%" />
                </RadzenStack>
            </form>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private RegisterFormModel model = new();
}
