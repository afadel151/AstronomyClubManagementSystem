@page "/account/logout"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Logging out...</PageTitle>

<RadzenStack AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.Center"
             Style="min-height: 40vh">
    <RadzenText Text="Logging out..." TextStyle="TextStyle.Body1" />
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width: 12rem" />
</RadzenStack>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        Navigation.NavigateTo("/bff/logout", forceLoad: true);
    }
}
