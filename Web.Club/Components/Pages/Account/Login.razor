@page "/account/login"

@inherits Web.Club.Components.Base.AnonymousOnlyComponentBase
@layout GuestLayout
@attribute [AllowAnonymous]
<PageTitle>Login</PageTitle>

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
             Style="min-height: calc(100vh - 6rem)">
    <RadzenCard Style="width: min(100%, 28rem)">
        <RadzenStack Gap="1rem">
            <RadzenStack Gap="0.25rem">
                <RadzenText Text="Sign in" TextStyle="TextStyle.H4" />
                <RadzenText Text="Use your astronomy club account." TextStyle="TextStyle.Body2" />
                @if (Error == "true")
                {
                    <RadzenText Text="Invalid email or password." TextStyle="TextStyle.Body2"
                                style="color: var(--rz-danger)" />
                }
            </RadzenStack>

            <form method="post" action="/bff/login" style="width: 100%">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%">
                        <RadzenTextBox Name="Email" Style="width: 100%" />
                    </RadzenFormField>

                    <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="width: 100%">
                        <RadzenPassword Name="Password" Style="width: 100%" />
                    </RadzenFormField>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <input type="checkbox" name="RememberMe" value="true" id="rememberMe" />
                        <label for="rememberMe" style="font-size: 0.875rem">Remember me</label>
                    </RadzenStack>

                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Icon="login"
                                  Text="Sign in" Style="width: 100%" />

                    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Icon="person_add"
                                  Text="Create account" Click="@(() => Nav.NavigateTo("/account/register"))"
                                  Style="width: 100%" />
                </RadzenStack>
            </form>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

