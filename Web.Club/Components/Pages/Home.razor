@page "/dashboard"
@attribute [Authorize]

@inject NavigationManager Navigation
@using Domain.Shared.Schemas

<PageTitle>Home</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenText Text="Astronomy Club Albattani" TextStyle="TextStyle.H3" />

    <AuthorizeView>
        <Authorized>
            <RadzenAlert Style=AlertStyle.Success Variant="Variant.Flat" Shade="Shade.Lighter">
                @($"Welcome back, {context.User.Identity?.Name}.")
            </RadzenAlert>
        </Authorized>
        <NotAuthorized>
            <RadzenAlert Style=AlertStyle.Success Variant="Variant.Flat" Shade="Shade.Lighter">
                Sign in to access Club's Managment system
            </RadzenAlert>
            <RadzenButton Icon="login" Text="Sign in" Click="@(() => Navigation.NavigateTo("/account/login"))"
                          ButtonStyle="ButtonStyle.Primary" Style="width: fit-content" />
        </NotAuthorized>
    </AuthorizeView>

    <AuthorizeView Roles="@Admins">
        <RadzenCard Style="width: min(100%, 36rem)">
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Administration" TextStyle="TextStyle.H5" />
                <RadzenText Text="This section is rendered only for Admin and SuperAdmin roles." />
            </RadzenStack>
        </RadzenCard>
    </AuthorizeView>
</RadzenStack>

@code {
    private const string Admins = $"{AuthConstants.Roles.Admin},{AuthConstants.Roles.SuperAdmin}";
}
