@inherits LayoutComponentBase
@inject NavigationManager Navigation

<RadzenComponents />
<RadzenNotification />
<RadzenDialog />
<RadzenContextMenu />
<RadzenTooltip />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Style="height: 100%;padding: 10px;"  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"  JustifyContent="JustifyContent.SpaceBetween"  >
            <RadzenButton 
                          Variant="Variant.Text"
                          Icon="travel_explore"
                          Text="Astronomy Club Albattani"
                          Click="@(() => Navigation.NavigateTo("/"))" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenAppearanceToggle />
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              Icon="login"
                              Text="Sign in"
                              Click="@(() => Navigation.NavigateTo("/account/login"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody >
        <main>
            @Body
        </main>
    </RadzenBody>
</RadzenLayout>
