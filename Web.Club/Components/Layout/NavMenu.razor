@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject NavigationManager UriHelper
@using Domain.Shared.Schemas
<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="Astronomy Club Albattani" />
        </RadzenStack>

       
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem"
                     Style="padding-right: 1rem">
            <RadzenAppearanceToggle />
            <AuthorizeView>
                <Authorized>
                    <RadzenText Text="@context.User.Identity?.Name" TextStyle="TextStyle.Body2" />
                    <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Medium"
                                  Click="@(() => Nav.NavigateTo("/account/profile"))" />
                    <RadzenButton Icon="logout" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium"
                                  Click="@(() => Nav.NavigateTo("/account/logout"))" />
                </Authorized>
                <NotAuthorized>
                    <RadzenButton Icon="login" Text="Sign in" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(() => Nav.NavigateTo("/account/login"))" />
                </NotAuthorized>
            </AuthorizeView>
        </RadzenStack>

    </RadzenStack>
</RadzenHeader>

<RadzenSidebar FullHeight="true" Responsive="false" @bind-Expanded="@sidebarExpanded">
    <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)">
        <RadzenPanelMenuItem Text="Dashboard" Icon="home" Path="/dashboard" />
        <RadzenPanelMenuItem Text="Events" Icon="event_note">
            <RadzenPanelMenuItem Text="All Events" Icon="calendar_view_month" Match="NavLinkMatch.All" Path="/events" />
            <RadzenPanelMenuItem Text="New Event" Icon="calendar_add_on"Path="/events/insert" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Projects" Icon="folder">
            <RadzenPanelMenuItem Text="All Projects" Icon="folder_open" Match="NavLinkMatch.All" Path="/projects"/>
            <RadzenPanelMenuItem Text="New Project" Icon="create_new_folder" Path="/projects/insert" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Observations" Icon="table_eye">
            <RadzenPanelMenuItem Text="Observation Sessions" Icon="schedule" Match="NavLinkMatch.All" Path="/observation_sessions"  />
            <RadzenPanelMenuItem Text="New Session" Icon="alarm_add" Path="/observation_sessions/insert"  />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Forecasts" Icon="flag">
            <RadzenPanelMenuItem Text="All Forecasts" Icon="calendar_view_week" Match="NavLinkMatch.All" Path="/forecasts"  />
            <RadzenPanelMenuItem Text="New Forecast" Icon="add_ad"  Path="/forecasts/insert"  />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Targets" Icon="planet">
            <RadzenPanelMenuItem Text="All Targets" Icon="assignment_globe" Match="NavLinkMatch.All" Path="/targets" />
            <RadzenPanelMenuItem Text="Catalogues" Icon="bookmark_stacks" Path="/catalogues" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Members" Icon="groups">
            <RadzenPanelMenuItem Text="All Members" Icon="patient_list" Match="NavLinkMatch.All" Path="/members"  />
            <RadzenPanelMenuItem Text="Club chat" Icon="chat" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Inventory" Icon="package_2">
            <RadzenPanelMenuItem Text="Equipments" Icon="box" Match="NavLinkMatch.All" Path="/equipments"  />
            <RadzenPanelMenuItem Text="Accessories" Icon="docs_add_on" Path="/equipments/accessories" />
            <RadzenPanelMenuItem Text="Brands" Icon="copyright" Path="/equipment/brands" />
            <RadzenPanelMenuItem Text="Models" Icon="tile_small"  />
            <RadzenPanelMenuItem Text="Categories" Icon="category"  />
            <RadzenPanelMenuItem Text="Maintenance" Icon="build"  />
            <RadzenPanelMenuItem Text="New equipment" Icon="rectangle_add" Path="/equipments/insert"  />

        </RadzenPanelMenuItem>
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    bool sidebarExpanded = true;

    private const string Admins = $"{AuthConstants.Roles.Admin},{AuthConstants.Roles.SuperAdmin}";
    private const string MemberManagers =
$"{AuthConstants.Roles.Admin},{AuthConstants.Roles.SuperAdmin},{AuthConstants.Roles.BoardMember}";
    private const string ManagersAndBoard =
$"{AuthConstants.Roles.Admin},{AuthConstants.Roles.SuperAdmin},{AuthConstants.Roles.BoardMember},{AuthConstants.Roles.EventManager},{AuthConstants.Roles.InventoryManager}";
}
